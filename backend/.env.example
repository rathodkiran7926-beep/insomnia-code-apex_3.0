PORT=3001
# Optional: improves GitHub API rate limits. Public repositories only.
GITHUB_TOKEN=
# Required for Gemini component/project guides and mentor answers. Keep real credentials in .env only.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash

# Optional ElevenLabs voice input/output for component discussions. Text needs only the Gemini settings above.
ELEVENLABS_API_KEY=

# Optional overrides. STT defaults to the documented scribe_v2; TTS uses ElevenLabs' default model.
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
