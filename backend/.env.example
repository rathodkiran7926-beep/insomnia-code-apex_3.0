PORT=3001
# Optional: improves GitHub API rate limits. Public repositories only.
GITHUB_TOKEN=
# Required for OpenAI-compatible AI component/project guides and mentor answers. Keep real credentials in .env only.
LLM_API_KEY=your_endpoint_api_key
LLM_BASE_URL=https://studio-unmapped-vicinity.ngrok-free.dev/v1
LLM_MODEL=qwen2.5-codebase:latest

# Optional ElevenLabs voice input/output for component discussions. Text needs only the OpenAI-compatible AI settings above.
ELEVENLABS_API_KEY=

# Optional overrides. STT defaults to the documented scribe_v2; TTS uses ElevenLabs' default model.
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Optional VS Code extension features. Enable only for direct local single-user use.
CODEBASE_MENTOR_LOCAL_CHECKPOINTS=0
CODEBASE_MENTOR_LOCAL_HANDOFFS=0
# Optional compatibility JSON-mode helper (1 enables structured response_format).
LLM_JSON_MODE=1
