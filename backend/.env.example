PORT=3001
# Explicit opt-in for private notes on the direct loopback, single-user backend.
# Leave disabled for hosted/proxied use; this is not production authentication.
CODEBASE_MENTOR_LOCAL_CHECKPOINTS=0
# Independent opt-in for local reviewed handoff preparation (no hosted sharing).
CODEBASE_MENTOR_LOCAL_HANDOFFS=0
# Optional: improves GitHub API rate limits. Public repositories only.
GITHUB_TOKEN=
# OpenAI-compatible LLM endpoint (used by Mentor, discussion, guides and documentation).
# Store your real key ONLY in ignored backend/.env, never in this example or the VSIX.
LLM_API_KEY=
LLM_BASE_URL=https://studio-unmapped-vicinity.ngrok-free.dev/v1
# Leave blank to discover a sole advertised model at /models; set the exact ID if multiple exist.
LLM_MODEL=
# Set to 0 only if the provider does not support response_format=json_object.
LLM_JSON_MODE=1

# Optional ElevenLabs voice input/output for component discussions. Text needs only the LLM settings above.
ELEVENLABS_API_KEY=

# Optional overrides. STT defaults to the documented scribe_v2; TTS uses ElevenLabs' default model.
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
