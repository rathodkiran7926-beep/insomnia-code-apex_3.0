{
  "name": "codebase-mentor-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "evaluate:agent-context": "node scripts/evaluate-agent-context-bridge.js",
    "evaluate:workspace-agent-context": "node scripts/evaluate-workspace-agent-context.js",
    "test": "node --test test/*.test.js",
    "check:llm": "node --env-file-if-exists=.env scripts/check-llm.js",
    "verify:public": "node scripts/verify-public.js",
    "verify:http": "node scripts/verify-http.js",
    "verify:ui": "node scripts/verify-ui.js",
    "verify:discussion": "node scripts/verify-discussion-ui.js",
    "verify:pr": "node scripts/verify-pr.js",
    "verify:pr-ui": "node scripts/verify-pr-ui.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "tar-stream": "^3.1.7",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  }
}
