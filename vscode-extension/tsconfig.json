{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "rootDir": "src", "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"]
}
