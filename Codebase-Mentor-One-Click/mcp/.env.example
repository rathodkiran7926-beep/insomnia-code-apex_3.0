# Hosted or local Codebase Mentor backend.
CODEBASE_MENTOR_API_URL=http://127.0.0.1:3001

# Optional explicit target if a harness does not launch MCP in the workspace directory.
# Supports public GitHub URLs only in the current analyzer.
# CODEBASE_MENTOR_REPOSITORY_URL=https://github.com/owner/repository
# CODEBASE_MENTOR_WORKSPACE=C:/path/to/your/repository
# CODEBASE_MENTOR_ANALYSIS_TIMEOUT_MS=280000

# Optional bearer token when the backend deployment requires one.
# CODEBASE_MENTOR_API_TOKEN=

# Backend request timeout in milliseconds.
# CODEBASE_MENTOR_API_TIMEOUT_MS=30000

# Streamable HTTP transport settings.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3921
# MCP_HTTP_TOKEN=
# MCP_HTTP_ALLOWED_ORIGINS=
# MCP_HTTP_RATE_LIMIT=120
# MCP_HTTP_MAX_CONCURRENT=16
