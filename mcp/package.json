{
  "name": "codebase-mentor-mcp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/stdio.js",
    "start:http": "node --env-file-if-exists=.env src/http.js",
    "test": "node --test test/*.test.js",
    "verify": "node --env-file-if-exists=.env scripts/verify-stdio.js",
    "verify:http": "node --env-file-if-exists=.env scripts/verify-http.js",
    "print-config": "node scripts/print-config.js",
    "print-config:http": "node scripts/print-config.js --http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0"
  }
}
